<UserControl x:Class="CharacterPromptGenerator.App.Views.DrawView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CharacterPromptGenerator.App.Controls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="330"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ── 左：方案與分類設定 ───────────────────────── -->
    <Border Style="{StaticResource Card}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="抽題方案" Style="{StaticResource SectionTitle}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"/>
            <Button Grid.Column="1" Content="套用" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"
                    Command="{Binding ApplyPresetCommand}" ToolTip="把方案的分類與數量套用到下方"/>
          </Grid>
          <WrapPanel Margin="0,6,0,0">
            <Button Content="另存新方案" Style="{StaticResource SmallButton}" Margin="0,0,4,4" Command="{Binding SavePresetAsCommand}"/>
            <Button Content="覆寫" Style="{StaticResource SmallButton}" Margin="0,0,4,4" Command="{Binding OverwritePresetCommand}"
                    ToolTip="用下方目前的設定覆寫選取的方案"/>
            <Button Content="改名" Style="{StaticResource SmallButton}" Margin="0,0,4,4" Command="{Binding RenamePresetCommand}"/>
            <Button Content="刪除" Style="{StaticResource SmallButton}" Margin="0,0,4,4" Command="{Binding DeletePresetCommand}"/>
          </WrapPanel>

          <Grid Margin="0,12,0,6">
            <TextBlock Text="分類與數量" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="全選" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Command="{Binding CheckAllCommand}"/>
              <Button Content="全不選" Style="{StaticResource SmallButton}" Margin="0" Command="{Binding CheckNoneCommand}"/>
            </StackPanel>
          </Grid>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectionSummary}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="row" Padding="4,5" CornerRadius="6" ToolTip="{Binding ToolTipText}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding LibraryEnabled}">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="avail" Text="{Binding AvailabilityText}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                      </StackPanel>
                    </CheckBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="−" Style="{StaticResource IconButton}" Command="{Binding DecreaseCommand}"/>
                      <TextBlock Text="{Binding Count}" Width="30" TextAlignment="Center" VerticalAlignment="Center"
                                 FontSize="15" FontWeight="SemiBold"/>
                      <Button Content="+" Style="{StaticResource IconButton}" Command="{Binding IncreaseCommand}"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsChecked}" Value="False">
                    <Setter TargetName="row" Property="Opacity" Value="0.55"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsShort}" Value="True">
                    <Setter TargetName="avail" Property="Foreground" Value="{StaticResource Warning}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ── 右：結果 ─────────────────────────────────── -->
    <DockPanel Grid.Column="2">
      <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
        <Button Content="{Binding GenerateButtonText}" Style="{StaticResource PrimaryButton}" FontSize="15" Padding="18,9"
                Margin="0,0,8,6" Command="{Binding GenerateAllCommand}" ToolTip="Ctrl+F5"/>
        <Button Content="🔁 重抽未鎖定" FontSize="14" Padding="14,9" Margin="0,0,8,6" Command="{Binding RerollUnlockedCommand}" ToolTip="F5"/>
        <Button Content="🔓 解除全部鎖定" Padding="12,9" Margin="0,0,8,6" Command="{Binding UnlockAllCommand}"/>
        <Button Content="📋 複製題目" Padding="12,9" Margin="0,0,8,6" Command="{Binding CopyCommand}" ToolTip="Ctrl+Shift+C"/>
        <Button Content="{Binding FavoriteButtonText}" Padding="12,9" Margin="0,0,8,6" Command="{Binding FavoriteCommand}"/>
        <Button Content="📺 直播展示模式" Padding="12,9" Margin="0,0,8,6" Command="{Binding OpenDisplayCommand}"
                ToolTip="開啟大字體的獨立視窗，適合 OBS 視窗擷取"/>
      </WrapPanel>

      <Border DockPanel.Dock="Top" Background="{StaticResource WarningSoft}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
              Visibility="{Binding Warnings, Converter={StaticResource NotEmptyToVis}}">
        <TextBlock Text="{Binding Warnings}" Foreground="{StaticResource Warning}" TextWrapping="Wrap"/>
      </Border>

      <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="2,8,0,0"/>

      <Grid>
        <TextBlock Text="🎨 準備好了嗎？按「產生角色題目」開始。" FontSize="18" Foreground="{StaticResource TextMuted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasResult, Converter={StaticResource NotEmptyToVis}, ConverterParameter=invert}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="14,10" MinWidth="220">
                  <StackPanel>
                    <Grid Margin="0,0,0,6">
                      <c:EmojiTextBlock Value="{Binding CategoryName}" FontSize="13" FontWeight="SemiBold"
                                        Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                      <Button Content="🎲 重抽此類" Style="{StaticResource SmallButton}" HorizontalAlignment="Right" Margin="0"
                              Command="{Binding RerollCommand}" CommandParameter="{Binding CategoryId}"
                              ToolTip="只重抽這個分類中未鎖定的項目"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border x:Name="slot" Background="{StaticResource BgCardAlt}" CornerRadius="8" Padding="12,8"
                                  Margin="0,0,8,6" BorderThickness="1" BorderBrush="Transparent" MinWidth="150">
                            <StackPanel>
                              <StackPanel Orientation="Horizontal">
                                <c:EmojiTextBlock Value="{Binding Emoji}" IsEmojiField="True" FontSize="34" EmojiScale="1"
                                                  Margin="0,0,8,0" VerticalAlignment="Center"
                                                  Visibility="{Binding HasEmoji, Converter={StaticResource NotEmptyToVis}}"/>
                                <c:EmojiTextBlock Value="{Binding Text}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                                                  TextWrapping="Wrap" MaxWidth="420"/>
                              </StackPanel>
                              <TextBlock Text="{Binding Notes}" Style="{StaticResource Muted}" MaxWidth="420" Margin="0,2,0,0"
                                         Visibility="{Binding HasNotes, Converter={StaticResource NotEmptyToVis}}"/>
                              <ToggleButton Style="{StaticResource LockToggle}" IsChecked="{Binding Locked}" AutomationProperties.Name="鎖定切換"
                                            HorizontalAlignment="Left" Margin="-6,4,0,0"/>
                            </StackPanel>
                          </Border>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Locked}" Value="True">
                              <Setter TargetName="slot" Property="BorderBrush" Value="{StaticResource Accent}"/>
                              <Setter TargetName="slot" Property="Background" Value="{StaticResource AccentSoft}"/>
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>
