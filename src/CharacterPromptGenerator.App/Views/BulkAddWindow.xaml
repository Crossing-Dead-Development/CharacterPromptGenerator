<Window x:Class="CharacterPromptGenerator.App.Views.BulkAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="多行貼上新增詞條" Width="640" Height="560" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgApp}">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource SectionTitle}">
        <Run Text="加入分類："/><Run x:Name="CategoryRun" Foreground="{StaticResource Accent}"/>
      </TextBlock>
      <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                 Text="每行一個詞條，整行就是詞條內容（Emoji 可以直接寫在文字裡）。空行會被略過；與此分類已有詞條或貼上內容中重複的行不會加入。"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom">
      <TextBlock x:Name="PreviewText" Margin="0,10,0,0" TextWrapping="Wrap"/>
      <TextBlock x:Name="DuplicateText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource Warning}" MaxHeight="80"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button x:Name="AddButton" Content="新增" Style="{StaticResource PrimaryButton}" Click="Add_Click" MinWidth="100"/>
        <Button Content="取消" IsCancel="True" MinWidth="80" Margin="0"/>
      </StackPanel>
    </StackPanel>

    <TextBox x:Name="InputBox" Style="{StaticResource MultilineBox}" TextChanged="Input_TextChanged"
             VerticalScrollBarVisibility="Auto" FontSize="14"/>
  </DockPanel>
</Window>
