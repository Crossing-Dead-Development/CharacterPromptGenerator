<Window x:Class="CharacterPromptGenerator.App.Views.BulkAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CharacterPromptGenerator.App.Infrastructure"
        Title="{l:T Bulk_WindowTitle}" Width="640" Height="560" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgApp}">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource SectionTitle}">
        <Run Text="{l:T Bulk_CategoryLabel}"/><Run x:Name="CategoryRun" Foreground="{StaticResource Accent}"/>
      </TextBlock>
      <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                 Text="{l:T Bulk_Hint}"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom">
      <TextBlock x:Name="PreviewText" Margin="0,10,0,0" TextWrapping="Wrap"/>
      <TextBlock x:Name="DuplicateText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource Warning}" MaxHeight="80"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button x:Name="AddButton" Content="{l:T Bulk_Add}" Style="{StaticResource PrimaryButton}" Click="Add_Click" MinWidth="100"/>
        <Button Content="{l:T Common_Cancel}" IsCancel="True" MinWidth="80" Margin="0"/>
      </StackPanel>
    </StackPanel>

    <TextBox x:Name="InputBox" Style="{StaticResource MultilineBox}" TextChanged="Input_TextChanged"
             VerticalScrollBarVisibility="Auto" FontSize="14"/>
  </DockPanel>
</Window>
