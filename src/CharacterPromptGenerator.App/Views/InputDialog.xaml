<Window x:Class="CharacterPromptGenerator.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgApp}">
  <StackPanel Margin="20">
    <TextBlock x:Name="LabelText" Style="{StaticResource Label}" Margin="0,0,0,6"/>
    <TextBox x:Name="ValueBox"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="確定" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" MinWidth="80"/>
      <Button Content="取消" IsCancel="True" MinWidth="80" Margin="0"/>
    </StackPanel>
  </StackPanel>
</Window>
