<UserControl x:Class="CharacterPromptGenerator.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CharacterPromptGenerator.App.Controls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="280"/>
    </Grid.ColumnDefinitions>

    <!-- ── 分類 ─────────────────────────────────────── -->
    <Border Style="{StaticResource Card}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
          <TextBlock Text="分類" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
          <Button Content="＋ 新增分類" Style="{StaticResource SmallButton}" HorizontalAlignment="Right" Margin="0"
                  Command="{Binding NewCategoryCommand}"/>
        </Grid>

        <!-- 分類表單 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"
                    Visibility="{Binding IsRealCategorySelected, Converter={StaticResource BoolToVis}}">
          <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,4"/>
          <TextBlock Text="分類名稱" Style="{StaticResource Label}"/>
          <TextBox Text="{Binding CatName, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="說明" Style="{StaticResource Label}"/>
          <TextBox Text="{Binding CatDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineBox}" Height="52"/>
          <Grid Margin="0,8,0,0">
            <CheckBox Content="啟用（可被抽到）" IsChecked="{Binding CatEnabled}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock Text="預設數量" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBox Text="{Binding CatDefaultCount, UpdateSourceTrigger=PropertyChanged}" Width="44" HorizontalContentAlignment="Center"/>
            </StackPanel>
          </Grid>
          <WrapPanel Margin="0,10,0,0">
            <Button Content="💾 儲存分類" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCategoryCommand}" Margin="0,0,4,4"/>
            <Button Content="↑" Command="{Binding MoveCategoryUpCommand}" Margin="0,0,4,4" ToolTip="往上移"/>
            <Button Content="↓" Command="{Binding MoveCategoryDownCommand}" Margin="0,0,4,4" ToolTip="往下移"/>
            <Button Content="刪除" Style="{StaticResource DangerButton}" Command="{Binding DeleteCategoryCommand}" Margin="0,0,0,4"/>
          </WrapPanel>
        </StackPanel>

        <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Opacity="{Binding Opacity}">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,44,0"/>
                <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" HorizontalAlignment="Right"
                           ToolTip="可抽數 / 總數"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ── 詞條表格 ─────────────────────────────────── -->
    <DockPanel Grid.Column="2">
      <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
        <Button Content="📥 匯入詞庫" Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}" Margin="0,0,6,0"/>
        <Button Content="📤 匯出 JSON" Command="{Binding ExportJsonCommand}" Margin="0,0,6,0"/>
        <Button Content="📤 匯出 CSV" Command="{Binding ExportCsvCommand}" Margin="0"/>
      </WrapPanel>

      <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="160"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid>
          <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="30,5,28,5"
                   AutomationProperties.Name="搜尋詞條"/>
          <TextBlock Text="🔍" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource TextMuted}"/>
          <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,4,0" Background="Transparent"
                  BorderThickness="0" Command="{Binding ClearSearchCommand}" ToolTip="清除搜尋"
                  Visibility="{Binding Search, Converter={StaticResource NotEmptyToVis}}"/>
        </Grid>
        <ComboBox Grid.Column="1" Width="110" Margin="8,0,0,0" SelectedIndex="{Binding StatusFilter}">
          <ComboBoxItem Content="全部狀態"/>
          <ComboBoxItem Content="只看啟用"/>
          <ComboBoxItem Content="只看停用"/>
        </ComboBox>
      </Grid>

      <!-- 批次操作 -->
      <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
        <TextBlock Style="{StaticResource Muted}">
          <Run Text="{Binding SelectionText, Mode=OneWay}"/><Run Text="　·　"/><Run Text="{Binding CountSummary, Mode=OneWay}"/>
        </TextBlock>
        <WrapPanel Margin="0,6,0,0">
          <Button Content="啟用" Style="{StaticResource SmallButton}" Command="{Binding EnableEntriesCommand}" VerticalAlignment="Center"/>
          <Button Content="停用" Style="{StaticResource SmallButton}" Command="{Binding DisableEntriesCommand}" VerticalAlignment="Center"/>
          <ComboBox Width="150" Height="28" ItemsSource="{Binding RealCategories}" DisplayMemberPath="Name" SelectedValuePath="Id"
                    SelectedValue="{Binding MoveTargetCategoryId}" Margin="10,0,4,0" ToolTip="移動目標分類" VerticalAlignment="Center"/>
          <Button Content="移到分類" Style="{StaticResource SmallButton}" Command="{Binding MoveEntriesCommand}" VerticalAlignment="Center"/>
          <Button Content="🗑 刪除選取" Style="{StaticResource DangerButton}" Padding="8,3" FontSize="12" Margin="10,0,0,0"
                  Command="{Binding DeleteEntriesCommand}" VerticalAlignment="Center"/>
        </WrapPanel>
      </StackPanel>

      <DataGrid x:Name="EntriesGrid" ItemsSource="{Binding EntriesView}" SelectionMode="Extended"
                SelectionChanged="EntriesGrid_SelectionChanged">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Enabled}" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTextColumn Header="分類" Binding="{Binding CategoryName}" Width="110"/>
          <DataGridTemplateColumn Header="Emoji" Width="54">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><c:EmojiTextBlock Value="{Binding Emoji}" IsEmojiField="True" FontSize="21" EmojiScale="1" VerticalAlignment="Center"/></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="詞條" Width="2*" SortMemberPath="Text">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><c:EmojiTextBlock Value="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="備註" Binding="{Binding Notes}" Width="2*"/>
          <DataGridTextColumn Header="標籤" Binding="{Binding TagsText}" Width="*"/>
          <DataGridTextColumn Header="狀態" Binding="{Binding StatusText}" Width="62"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <!-- ── 詞條表單 ─────────────────────────────────── -->
    <Border Grid.Column="4" Style="{StaticResource Card}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="分類" Style="{StaticResource Label}"/>
          <ComboBox ItemsSource="{Binding RealCategories}" DisplayMemberPath="Name" SelectedValuePath="Id"
                    SelectedValue="{Binding FormCategoryId}"/>
          <TextBlock Text="詞條文字（必填）" Style="{StaticResource Label}"/>
          <TextBox Text="{Binding FormText, UpdateSourceTrigger=PropertyChanged}" FontSize="15"/>
          <TextBlock Text="{Binding DuplicateWarning}" Foreground="{StaticResource Warning}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                     Visibility="{Binding DuplicateWarning, Converter={StaticResource NotEmptyToVis}}"/>
          <TextBlock Text="Emoji（選填，Win + . 可開啟表情面板）" Style="{StaticResource Label}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding FormEmoji, UpdateSourceTrigger=PropertyChanged}" FontSize="16" AutomationProperties.Name="Emoji 輸入"/>
            <Border Grid.Column="1" MinWidth="52" MaxWidth="160" Height="52" Padding="4,0" Margin="8,0,0,0" CornerRadius="8"
                    Background="{StaticResource BgInput}" ToolTip="預覽：抽題結果中實際顯示的圖片">
              <c:EmojiTextBlock Value="{Binding FormEmoji}" IsEmojiField="True" FontSize="36" EmojiScale="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Emoji 預覽"/>
            </Border>
          </Grid>
          <TextBlock Text="{Binding FormEmojiInfo}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                     Visibility="{Binding FormEmojiInfo, Converter={StaticResource NotEmptyToVis}}"/>
          <TextBlock Text="備註" Style="{StaticResource Label}"/>
          <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineBox}" Height="70"/>
          <TextBlock Text="標籤（以 | 或逗號分隔）" Style="{StaticResource Label}"/>
          <TextBox Text="{Binding FormTags, UpdateSourceTrigger=PropertyChanged}"/>
          <CheckBox Content="啟用（可被抽到）" IsChecked="{Binding FormEnabled}" Margin="0,10,0,0"/>
          <WrapPanel Margin="0,14,0,0">
            <Button Content="{Binding SaveEntryText}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveEntryCommand}" Margin="0,0,6,6"/>
            <Button Content="清空／改為新增" Command="{Binding NewEntryCommand}" Margin="0,0,0,6"/>
          </WrapPanel>

          <Separator Background="{StaticResource BorderBrush}" Margin="0,12"/>
          <TextBlock Text="大量新增" Style="{StaticResource SectionTitle}"/>
          <TextBlock Style="{StaticResource Muted}" Text="把很多詞貼進來，每行一個，一次加入左側選取的分類。" Margin="0,0,0,8"/>
          <Button Content="📋 多行貼上新增" Command="{Binding BulkAddCommand}" HorizontalAlignment="Left"/>
          <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                     Text="更大量的詞庫請用上方「匯入詞庫」，支援 JSON / CSV / TXT，匯入前會先預覽並自動備份。"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
