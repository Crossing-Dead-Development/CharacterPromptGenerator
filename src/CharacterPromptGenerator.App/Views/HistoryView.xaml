<UserControl x:Class="CharacterPromptGenerator.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CharacterPromptGenerator.App.Controls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="380"/>
    </Grid.ColumnDefinitions>

    <DockPanel>
      <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
        <TextBlock Text="歷史與收藏" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <CheckBox Content="只看收藏 ⭐" IsChecked="{Binding FavoritesOnly}" Margin="0,0,12,0"/>
          <Button Content="清除未收藏紀錄" Style="{StaticResource SmallButton}" Margin="0" Command="{Binding ClearCommand}"/>
        </StackPanel>
      </Grid>
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTextColumn Header="" Binding="{Binding Star}" Width="32"/>
          <DataGridTextColumn Header="時間" Binding="{Binding TimeText}" Width="150"/>
          <DataGridTemplateColumn Header="內容" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><c:EmojiTextBlock Value="{Binding Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <Border Grid.Column="2" Style="{StaticResource Card}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="內容" Style="{StaticResource SectionTitle}"/>
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
          <Button Content="📋 複製" Command="{Binding CopyCommand}" Margin="0,0,6,6"/>
          <Button Content="⭐ 收藏／取消" Command="{Binding ToggleFavoriteCommand}" Margin="0,0,6,6"/>
          <Button Content="↩ 載入到抽題畫面" Command="{Binding LoadCommand}" Margin="0,0,6,6"
                  ToolTip="載入後所有項目先鎖定，可解除部分鎖定後重抽"/>
          <Button Content="刪除" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="0,0,0,6"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,8,0,0"
                   Text="紀錄保存的是抽題當下的文字快照：之後修改或刪除詞條，舊紀錄也不會改變。"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBox Text="{Binding SelectedText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MultilineBox}"
                   FontSize="15" BorderThickness="0" Background="Transparent" Padding="0"/>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
