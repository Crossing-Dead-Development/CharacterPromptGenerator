<UserControl x:Class="CharacterPromptGenerator.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:CharacterPromptGenerator.App.Infrastructure"
             xmlns:c="clr-namespace:CharacterPromptGenerator.App.Controls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="380"/>
    </Grid.ColumnDefinitions>

    <DockPanel>
      <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
        <TextBlock Text="{l:T History_Title}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <CheckBox Content="{l:T History_FavoritesOnly}" IsChecked="{Binding FavoritesOnly}" Margin="0,0,12,0"/>
          <Button Content="{l:T History_ClearButton}" Style="{StaticResource SmallButton}" Margin="0" Command="{Binding ClearCommand}"/>
        </StackPanel>
      </Grid>
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTextColumn Header="" Binding="{Binding Star}" Width="32"/>
          <DataGridTextColumn Header="{l:T Common_Time}" Binding="{Binding TimeText}" Width="150"/>
          <DataGridTemplateColumn Header="{l:T History_Content}" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><c:EmojiTextBlock Value="{Binding Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <Border Grid.Column="2" Style="{StaticResource Card}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{l:T History_Content}" Style="{StaticResource SectionTitle}"/>
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
          <Button Content="{l:T History_Copy}" Command="{Binding CopyCommand}" Margin="0,0,6,6"/>
          <Button Content="{l:T History_ToggleFavorite}" Command="{Binding ToggleFavoriteCommand}" Margin="0,0,6,6"/>
          <Button Content="{l:T History_Load}" Command="{Binding LoadCommand}" Margin="0,0,6,6"
                  ToolTip="{l:T History_LoadTip}"/>
          <Button Content="{l:T Common_Delete}" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="0,0,0,6"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,8,0,0"
                   Text="{l:T History_SnapshotNote}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBox Text="{Binding SelectedText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MultilineBox}"
                   FontSize="15" BorderThickness="0" Background="Transparent" Padding="0"/>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
