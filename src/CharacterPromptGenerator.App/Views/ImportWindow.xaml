<Window x:Class="CharacterPromptGenerator.App.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CharacterPromptGenerator.App.Controls"
        Title="匯入詞庫｜預覽" Width="980" Height="700" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgApp}">
  <DockPanel Margin="20">
    <!-- 檔案資訊與模式 -->
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource SectionTitle}" FontSize="17">
        <Run Text="📄"/> <Run Text="{Binding FileName, Mode=OneWay}"/>
      </TextBlock>
      <TextBlock Text="{Binding FilePath}" Style="{StaticResource Muted}"/>
      <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,10">
        <Run Text="格式："/><Run Text="{Binding FormatText, Mode=OneWay}"/>
      </TextBlock>

      <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <RadioButton Content="合併匯入（建議：保留現有詞庫，只加入新詞）" IsChecked="{Binding IsMerge}" GroupName="mode" Margin="0,0,24,0"/>
            <RadioButton Content="取代整個詞庫" IsChecked="{Binding IsReplace}" GroupName="mode"/>
          </StackPanel>
          <CheckBox Content="允許建立檔案中出現的新分類（取消勾選時，這些詞條會被略過）" IsChecked="{Binding AllowNewCategories}"
                    Margin="0,8,0,0" Visibility="{Binding IsMerge, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{Binding ReplaceWarning}" Foreground="{StaticResource Danger}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"
                     Visibility="{Binding ReplaceWarning, Converter={StaticResource NotEmptyToVis}}"/>
        </StackPanel>
      </Border>

      <TextBlock Text="解析中…" Foreground="{StaticResource Info}" Margin="0,0,0,8"
                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

      <Border Background="{StaticResource DangerSoft}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
              Visibility="{Binding FatalError, Converter={StaticResource NotEmptyToVis}}">
        <StackPanel>
          <TextBlock Text="❌ 無法匯入這個檔案（目前詞庫不受影響）" Foreground="{StaticResource Danger}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding FatalError}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource WarningSoft}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
              Visibility="{Binding BlockReason, Converter={StaticResource NotEmptyToVis}}">
        <TextBlock Text="{Binding BlockReason}" Foreground="{StaticResource Warning}" TextWrapping="Wrap"/>
      </Border>

      <TextBlock Text="{Binding SummaryText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="✔ 套用匯入" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" MinWidth="120" Padding="16,8"/>
      <Button Content="取消" IsCancel="True" MinWidth="90" Padding="16,8" Margin="0"/>
    </StackPanel>

    <!-- 預覽明細 -->
    <TabControl>
      <TabItem Header="{Binding AddedHeader}">
        <DataGrid ItemsSource="{Binding Added}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="行" Binding="{Binding Line}" Width="50"/>
            <DataGridTextColumn Header="分類" Binding="{Binding CategoryName}" Width="150"/>
            <DataGridCheckBoxColumn Header="新分類" Binding="{Binding InNewCategory, Mode=OneWay}" Width="56"/>
            <DataGridTemplateColumn Header="Emoji" Width="54">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><c:EmojiTextBlock Value="{Binding Emoji}" IsEmojiField="True" FontSize="21" EmojiScale="1" VerticalAlignment="Center"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="詞條" Width="2*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><c:EmojiTextBlock Value="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="備註" Binding="{Binding Notes}" Width="2*"/>
            <DataGridTextColumn Header="標籤" Binding="{Binding TagsText}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{Binding NewCategoriesHeader}">
        <DataGrid ItemsSource="{Binding NewCategories}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="將建立新分類" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="詞條數" Binding="{Binding EntryCount}" Width="80"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{Binding SkippedHeader}">
        <DataGrid ItemsSource="{Binding Skipped}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="行" Binding="{Binding Line}" Width="50"/>
            <DataGridTextColumn Header="分類" Binding="{Binding CategoryName}" Width="150"/>
            <DataGridTextColumn Header="詞條" Binding="{Binding Text}" Width="*"/>
            <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="220"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{Binding ProblemsHeader}">
        <DataGrid ItemsSource="{Binding Problems}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="行" Binding="{Binding LineText}" Width="50"/>
            <DataGridTextColumn Header="說明" Binding="{Binding Message}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
