<UserControl x:Class="CharacterPromptGenerator.App.Views.DataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:CharacterPromptGenerator.App.Infrastructure">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="{l:T Main_DataLocation}" Style="{StaticResource SectionTitle}"/>
            <TextBox Text="{Binding DataDir, Mode=OneWay}" IsReadOnly="True"/>
            <TextBlock Text="{Binding ModeText}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding Stats}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            <WrapPanel Margin="0,10,0,0">
              <Button Content="{l:T Data_OpenFolder}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,6,6"/>
              <Button Content="{Binding PortableButtonText}" Command="{Binding TogglePortableCommand}" Margin="0,0,0,6"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="{l:T Data_ImportExportTitle}" Style="{StaticResource SectionTitle}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10">
              <Run Text="{l:T Data_FormatJson}"/><LineBreak/>
              <Run Text="{l:T Data_FormatCsv}"/><LineBreak/>
              <Run Text="{l:T Data_FormatTxt}"/><LineBreak/>
              <Run Text="{l:T Data_ImportNote}"/>
            </TextBlock>
            <WrapPanel>
              <Button Content="{l:T Common_Import}" Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}" Margin="0,0,6,6"/>
              <Button Content="{l:T Data_ExportJson}" Command="{Binding ExportJsonCommand}" Margin="0,0,6,6"/>
              <Button Content="{l:T Common_ExportCsv}" Command="{Binding ExportCsvCommand}" Margin="0,0,0,6"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="{l:T Data_EmojiTitle}" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="{Binding EmojiStatus}" Style="{StaticResource Muted}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                       Text="{l:T Data_EmojiHint}"/>
            <WrapPanel Margin="0,10,0,0">
              <Button Content="{l:T Data_OpenEmojiFolder}" Command="{Binding OpenEmojiOverrideCommand}" Margin="0,0,6,6"/>
              <Button Content="{l:T Data_Licenses}" Command="{Binding ShowLicensesCommand}" Margin="0,0,0,6"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Background="{StaticResource WarningSoft}"
                Visibility="{Binding LoadMessages, Converter={StaticResource NotEmptyToVis}}">
          <StackPanel>
            <TextBlock Text="{l:T Data_LoadNotesTitle}" Style="{StaticResource SectionTitle}" Foreground="{StaticResource Warning}"/>
            <TextBlock Text="{Binding LoadMessages}" TextWrapping="Wrap" Foreground="{StaticResource Warning}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Column="2" Style="{StaticResource Card}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{l:T Data_BackupsTitle}" Style="{StaticResource SectionTitle}"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,10"
                   Text="{l:T Data_BackupsHint}"/>
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
          <Button Content="{l:T Data_BackupNow}" Style="{StaticResource PrimaryButton}" Command="{Binding BackupNowCommand}" Margin="0,0,6,6"/>
          <Button Content="{l:T Data_Restore}" Command="{Binding RestoreCommand}" Margin="0,0,6,6"/>
          <Button Content="{l:T Data_OpenBackupFolder}" Command="{Binding OpenBackupFolderCommand}" Margin="0,0,6,6"/>
          <Button Content="{l:T Data_Refresh}" Command="{Binding RefreshCommand}" Margin="0,0,0,6"/>
        </WrapPanel>
        <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" SelectionMode="Single">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{l:T Common_Time}" Binding="{Binding TimeText}" Width="150"/>
            <DataGridTextColumn Header="{l:T Common_Reason}" Binding="{Binding ReasonText}" Width="*"/>
            <DataGridTextColumn Header="{l:T Data_Size}" Binding="{Binding SizeText}" Width="70"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
