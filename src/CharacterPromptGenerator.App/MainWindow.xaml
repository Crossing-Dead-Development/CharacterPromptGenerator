<Window x:Class="CharacterPromptGenerator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CharacterPromptGenerator.App.Infrastructure"
        Title="{l:T Main_WindowTitle}"
        Height="760" Width="1240" MinHeight="560" MinWidth="960"
        Background="{StaticResource BgApp}"
        Icon="pack://application:,,,/Assets/CharacterPromptGenerator.ico"
        WindowStartupLocation="CenterScreen">

  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding Draw.RerollUnlockedCommand}"/>
    <KeyBinding Key="F5" Modifiers="Control" Command="{Binding Draw.GenerateAllCommand}"/>
    <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding Draw.CopyCommand}"/>
  </Window.InputBindings>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="190"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 側邊欄 -->
    <Border Background="{StaticResource BgSidebar}">
      <DockPanel Margin="10,16">
        <StackPanel DockPanel.Dock="Top" Margin="8,0,8,16">
          <TextBlock Text="{l:T Main_BrandTop}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
          <TextBlock Text="{l:T Main_BrandBottom}" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
          <TextBlock Text="Crossing Dead Development" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,0">
          <TextBlock Text="{l:T Main_LanguageLabel}" Style="{StaticResource Muted}" FontSize="10"/>
          <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="DisplayName"
                    FontSize="12" Margin="0,2,0,10" AutomationProperties.Name="Language"/>
          <TextBlock Text="{l:T Main_DataLocation}" Style="{StaticResource Muted}" FontSize="10"/>
          <TextBlock Text="{Binding DataPathText}" Style="{StaticResource Muted}" FontSize="10" ToolTip="{Binding DataPathText}"/>
          <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel>
          <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsChecked="{Binding IsDrawPage}">
            <TextBlock Text="{l:T Nav_Draw}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsChecked="{Binding IsEditorPage}">
            <TextBlock Text="{l:T Nav_Editor}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsChecked="{Binding IsHistoryPage}">
            <TextBlock Text="{l:T Nav_History}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsChecked="{Binding IsDataPage}">
            <TextBlock Text="{l:T Nav_Data}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
          </RadioButton>

          <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="8,24,8,0" LineHeight="18">
            <Run Text="{l:T Main_Shortcuts}"/><LineBreak/>
            <Run Text="{l:T Main_ShortcutReroll}"/><LineBreak/>
            <Run Text="{l:T Main_ShortcutRegenerate}"/><LineBreak/>
            <Run Text="{l:T Main_ShortcutCopy}"/>
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="16"/>
  </Grid>
</Window>
