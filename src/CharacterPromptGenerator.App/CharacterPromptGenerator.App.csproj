<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CharacterPromptGenerator</AssemblyName>
    <RootNamespace>CharacterPromptGenerator.App</RootNamespace>
    <Product>Character Design Prompt Generator</Product>
    <Company>Crossing Dead Development</Company>
    <Version>0.3.0</Version>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationIcon>Assets\CharacterPromptGenerator.ico</ApplicationIcon>
    <!-- 單一檔案發行時：WPF 原生 DLL 與內嵌資源一起打包並壓縮（免安裝 .NET） -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CharacterPromptGenerator.Core\CharacterPromptGenerator.Core.csproj" />
  </ItemGroup>

  <!-- 視窗標題列與工作列圖示（EXE 檔案圖示由上方的 ApplicationIcon 設定） -->
  <ItemGroup>
    <Resource Include="Assets\CharacterPromptGenerator.ico" />
  </ItemGroup>

  <!--
    發行版只有一個 EXE：以下資源全部內嵌。
    - SeedData\：首次啟動用的預設詞庫與方案（空白；詞庫由使用者自行匯入）。EXE 旁若有 SeedData\ 資料夾則優先使用。
    - Emoji\fluent-emoji-3d.zip：Fluent Emoji 3D 圖庫（MIT，Microsoft），不依賴 Windows 的 Emoji 字型。
    - THIRD-PARTY-NOTICES.md（含 MIT 授權全文）：在「資料與備份」頁的「第三方授權」顯示。
  -->
  <ItemGroup>
    <EmbeddedResource Include="SeedData\*.json" LogicalName="SeedData.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Emoji\fluent-emoji-3d.zip" LogicalName="Emoji.fluent-emoji-3d.zip" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="Licenses.THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

</Project>
