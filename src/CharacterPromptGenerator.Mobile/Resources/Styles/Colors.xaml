<?xml version="1.0" encoding="UTF-8" ?>
<!-- 與 Windows 版 Themes\Dark.xaml 相同的色彩 token。行動版只有深色主題。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="BgApp">#14101D</Color>
    <Color x:Key="BgBar">#0D0A14</Color>
    <Color x:Key="BgCard">#1E1730</Color>
    <Color x:Key="BgCardAlt">#261D3A</Color>
    <Color x:Key="BgInput">#2B2240</Color>
    <Color x:Key="BorderColor">#3D3058</Color>
    <Color x:Key="TextPrimary">#F4EEFF</Color>
    <Color x:Key="TextSecondary">#BDB0D8</Color>
    <Color x:Key="TextMuted">#8C7DAA</Color>
    <Color x:Key="Accent">#B388FF</Color>
    <Color x:Key="AccentText">#170A2E</Color>
    <Color x:Key="AccentSoft">#352452</Color>
    <Color x:Key="Danger">#EF6B6B</Color>
    <Color x:Key="Warning">#F5C84C</Color>
    <Color x:Key="WarningSoft">#3A3220</Color>
</ResourceDictionary>
