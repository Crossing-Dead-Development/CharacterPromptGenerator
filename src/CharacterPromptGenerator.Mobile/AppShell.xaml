<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="CharacterPromptGenerator.Mobile.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:l="clr-namespace:CharacterPromptGenerator.Mobile.Infrastructure"
       xmlns:views="clr-namespace:CharacterPromptGenerator.Mobile.Views"
       Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="{l:T Mobile_TabDraw}" Route="draw"
                      ContentTemplate="{DataTemplate views:DrawPage}" />
        <ShellContent Title="{l:T Mobile_TabLibrary}" Route="library"
                      ContentTemplate="{DataTemplate views:ComingSoonPage}" />
        <ShellContent Title="{l:T Mobile_TabHistory}" Route="history"
                      ContentTemplate="{DataTemplate views:ComingSoonPage}" />
        <ShellContent Title="{l:T Mobile_TabSettings}" Route="settings"
                      ContentTemplate="{DataTemplate views:ComingSoonPage}" />
    </TabBar>

</Shell>
