<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="CharacterPromptGenerator.Mobile.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:CharacterPromptGenerator.Mobile.Infrastructure"
             xmlns:vm="clr-namespace:CharacterPromptGenerator.Mobile.ViewModels"
             x:DataType="vm:HistoryViewModel"
             Title="{l:T History_Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{l:T History_ClearButton}" Command="{Binding ClearNonFavoritesCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="12,10,12,6" Spacing="8">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="{l:T Mobile_AllRecords}" Style="{StaticResource Segment}" Command="{Binding UseAllCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowAll}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
                            <Setter Property="BorderColor" Value="{StaticResource Accent}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="{l:T History_FavoritesOnly}" Style="{StaticResource Segment}" Command="{Binding UseFavoritesCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding FavoritesOnly}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
                            <Setter Property="BorderColor" Value="{StaticResource Accent}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
            <Label Text="{Binding Summary}" Style="{StaticResource Muted}" LineBreakMode="WordWrap" />
            <Label Text="{l:T Mobile_TapForActions}" Style="{StaticResource Muted}" LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" Margin="12,0">
            <CollectionView.EmptyView>
                <Label Text="{l:T Mobile_HistoryEmpty}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" Margin="24,40" />
            </CollectionView.EmptyView>
            <CollectionView.Footer>
                <Label Text="{l:T History_SnapshotNote}" Style="{StaticResource Muted}" LineBreakMode="WordWrap" Margin="0,8,0,20" />
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryRow">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsFavorite}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource Warning}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRowTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding TimeText}" Style="{StaticResource SectionTitle}" />
                                <Label Grid.Column="1" Text="⭐" IsVisible="{Binding IsFavorite}" />
                            </Grid>
                            <Label Text="{Binding Body}" FontSize="15" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
