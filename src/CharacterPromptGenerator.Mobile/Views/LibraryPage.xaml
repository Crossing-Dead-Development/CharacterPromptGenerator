<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="CharacterPromptGenerator.Mobile.Views.LibraryPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:CharacterPromptGenerator.Mobile.Infrastructure"
             xmlns:vm="clr-namespace:CharacterPromptGenerator.Mobile.ViewModels"
             x:DataType="vm:LibraryViewModel"
             Title="{l:T Mobile_TabLibrary}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{l:T Editor_AddCategory}" Command="{Binding AddCategoryCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Categories}" Margin="12,0">
        <CollectionView.Header>
            <VerticalStackLayout Padding="0,12,0,6" Spacing="10">
                <Label Text="{Binding Summary}" Style="{StaticResource Muted}" />
                <Border IsVisible="{Binding IsEmpty}" Style="{StaticResource Card}" Padding="20">
                    <Label Text="{l:T Mobile_NoCategories}" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                </Border>
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:CategoryItem">
                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Opacity="{Binding Opacity}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" LineBreakMode="WordWrap" />
                            <Label Text="{Binding Description}" IsVisible="{Binding HasDescription}"
                                   Style="{StaticResource Muted}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding CountText}" Style="{StaticResource Muted}" TextColor="{StaticResource Accent}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="›" FontSize="24" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
