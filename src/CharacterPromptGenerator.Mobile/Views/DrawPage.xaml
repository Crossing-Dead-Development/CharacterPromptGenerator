<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="CharacterPromptGenerator.Mobile.Views.DrawPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:CharacterPromptGenerator.Mobile.Infrastructure"
             xmlns:vm="clr-namespace:CharacterPromptGenerator.Mobile.ViewModels"
             x:DataType="vm:DrawViewModel"
             Title="{l:T Mobile_AppName}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{l:T Mobile_DrawSettings}" Command="{Binding OpenSettingsCommand}" />
        <!-- 較少用的動作放在 ⋮ 選單，讓小螢幕的結果區保有足夠空間 -->
        <ToolbarItem Text="{l:T Draw_RegenerateAll}" Command="{Binding RegenerateAllCommand}" Order="Secondary" />
        <ToolbarItem Text="{l:T Draw_UnlockAll}" Command="{Binding UnlockAllCommand}" Order="Secondary" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 目前方案與選取摘要：點一下進入抽題設定 -->
        <Border Grid.Row="0" Margin="12,10,12,4" Padding="14,10" Style="{StaticResource Card}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenSettingsCommand}" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding PresetText}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                <Label Text="{Binding SelectionSummary}" Style="{StaticResource Muted}" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="12,4,12,12" Spacing="10">

                <Label Text="{Binding StatusText}" Style="{StaticResource Muted}" LineBreakMode="WordWrap" />

                <Border IsVisible="{Binding HasMessage}" BackgroundColor="{StaticResource WarningSoft}"
                        Stroke="{StaticResource Warning}" StrokeShape="RoundRectangle 12" Padding="12,10">
                    <Label Text="{Binding Message}" TextColor="{StaticResource Warning}" LineBreakMode="WordWrap" />
                </Border>

                <!-- 詞庫是空的 -->
                <Border IsVisible="{Binding LibraryEmpty}" Style="{StaticResource Card}" Padding="20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{l:T Draw_EmptyTitle}" FontSize="20" FontAttributes="Bold" />
                        <Label Text="{l:T Mobile_EmptyHint}" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Label IsVisible="{Binding ShowReadyHint}" Text="{l:T Draw_Ready}" FontSize="18"
                       HorizontalTextAlignment="Center" Margin="0,40" LineBreakMode="WordWrap"
                       TextColor="{StaticResource TextSecondary}" />

                <Label IsVisible="{Binding HasResult}" Text="{l:T Mobile_TapToLock}" Style="{StaticResource Muted}" />

                <!-- 結果：每個分類一張卡片 -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ResultGroupViewModel">
                            <Border Style="{StaticResource Card}" Padding="12,8,12,12">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding CategoryName}" Style="{StaticResource SectionTitle}"
                                               VerticalOptions="Center" LineBreakMode="WordWrap" />
                                        <Button Grid.Column="1" Text="{l:T Draw_RerollCategory}" FontSize="13" Padding="10,4"
                                                MinimumHeightRequest="40"
                                                Command="{Binding RerollCommand}" CommandParameter="{Binding CategoryId}" />
                                    </Grid>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SlotViewModel">
                                                <Border x:Name="SlotCard" BackgroundColor="{StaticResource BgCardAlt}"
                                                        Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 12" Padding="12,10"
                                                        SemanticProperties.Description="{Binding Description}">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding Locked}" Value="True">
                                                            <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                                            <Setter Property="StrokeThickness" Value="2" />
                                                            <Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding ToggleLockCommand}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                        <Label Text="{Binding Emoji}" IsVisible="{Binding HasEmoji}"
                                                               FontSize="34" VerticalOptions="Center" />
                                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                            <Label Text="{Binding Text}" FontSize="20" FontAttributes="Bold"
                                                                   LineBreakMode="WordWrap" />
                                                            <Label Text="{Binding Notes}" IsVisible="{Binding HasNotes}"
                                                                   Style="{StaticResource Muted}" LineBreakMode="WordWrap" />
                                                        </VerticalStackLayout>
                                                        <Label Grid.Column="2" Text="{Binding LockGlyph}" FontSize="22"
                                                               VerticalOptions="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 底部操作：主要按鈕放在拇指最容易按到的位置 -->
        <Border Grid.Row="2" BackgroundColor="{StaticResource BgBar}" StrokeThickness="0" Padding="12,10,12,12">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button Text="{l:T History_Copy}" Command="{Binding CopyCommand}" />
                    <Button Grid.Column="1" Text="{l:T Mobile_Share}" Command="{Binding ShareCommand}" />
                    <Button Grid.Column="2" Text="{Binding FavoriteText}" Command="{Binding FavoriteCommand}" />
                </Grid>
                <Button Text="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" Style="{StaticResource PrimaryButton}" />
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
