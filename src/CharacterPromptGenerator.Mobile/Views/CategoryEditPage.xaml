<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="CharacterPromptGenerator.Mobile.Views.CategoryEditPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:CharacterPromptGenerator.Mobile.Infrastructure"
             xmlns:vm="clr-namespace:CharacterPromptGenerator.Mobile.ViewModels"
             x:DataType="vm:CategoryEditViewModel"
             Title="{l:T Mobile_CategorySettings}">

    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,24" Spacing="4">

            <Label Text="{l:T Editor_CategoryName}" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Name}" />

            <Label Text="{l:T Editor_Description}" Style="{StaticResource FieldLabel}" />
            <Editor Text="{Binding Description}" AutoSize="TextChanges" MinimumHeightRequest="48" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                <Label Text="{l:T Editor_EnabledCheck}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding Enabled}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Label Text="{l:T Editor_DefaultCount}" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="4">
                    <Button Text="−" WidthRequest="44" Padding="0" FontSize="20" Command="{Binding DecreaseCommand}"
                            SemanticProperties.Description="{l:T Mobile_Decrease}" />
                    <Label Text="{Binding DefaultCount}" WidthRequest="34" FontSize="18" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" VerticalOptions="Center" />
                    <Button Text="+" WidthRequest="44" Padding="0" FontSize="20" Command="{Binding IncreaseCommand}"
                            SemanticProperties.Description="{l:T Mobile_Increase}" />
                </HorizontalStackLayout>
            </Grid>

            <Button Text="{l:T Editor_SaveCategory}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" />

            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" Margin="0,16,0,0">
                <Button Text="{l:T Editor_MoveUp}" Command="{Binding MoveUpCommand}" />
                <Label Grid.Column="1" Text="{Binding PositionText}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="{l:T Editor_MoveDown}" Command="{Binding MoveDownCommand}" />
            </Grid>

            <Button Text="{l:T Common_Delete}" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,24,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
