<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 行動版只支援 Android（iOS 已於 2026-10-22 取消） -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>CharacterPromptGenerator.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>角色設計題目</ApplicationTitle>
    <ApplicationId>com.crossingdead.characterpromptgenerator</ApplicationId>
    <ApplicationDisplayVersion>0.3.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <Product>Character Design Prompt Generator</Product>
    <Company>Crossing Dead Development</Company>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#14101D" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#14101D" BaseSize="128,128" />
  </ItemGroup>

  <!-- 首次啟動用的預設詞庫與方案：直接引用 Windows 版的同一份檔案，兩邊不會各自分岔 -->
  <ItemGroup>
    <EmbeddedResource Include="..\CharacterPromptGenerator.App\SeedData\*.json" LogicalName="SeedData.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CharacterPromptGenerator.Core\CharacterPromptGenerator.Core.csproj" />
  </ItemGroup>

</Project>
